{
  "$schema": "https://raw.githubusercontent.com/warOnSaaS/suite/main/packages/tools/tools.schema.json",
  "app": "crm",
  "version": 1,
  "tools": [
    {
      "name": "crm.find",
      "title": "Find records",
      "description": "Search contacts, leads, organizations, deals and activities by any words: a name, a company, an email, a city, words from a note. Filter by kind, owner, deal stage, lead status or organization. Leave q empty to list.",
      "input": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Words to look for, e.g. \"birch\" or \"dana acme\""
          },
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "organizations",
              "deals",
              "activities"
            ],
            "description": "Only this kind of record"
          },
          "owner": {
            "type": "string",
            "description": "Only records owned by this person (name, or \"me\")"
          },
          "stage": {
            "type": "string",
            "description": "Deals only: a stage name, e.g. \"Proposal\""
          },
          "status": {
            "type": "string",
            "description": "Contacts only: a lead status (lead, working, qualified, customer, not_a_fit), or \"lead\" for every open lead"
          },
          "org": {
            "type": "string",
            "description": "Only records at this organization (name or id)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "At most this many (default 25)"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.open_record",
      "title": "Open a record",
      "description": "One contact, organization, deal or activity with its details, links, timeline (newest first) and recent changes. Takes an id from find.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The record id, e.g. c_dana01"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.describe",
      "title": "Describe the CRM",
      "description": "The kinds of record and their fields: our name, Salesforce API name, type, picklist values, custom fields, stages with probability and forecast category, and saved views. Give a kind for its fields; leave it out for the overview. Matches Salesforce getObjectSchema.",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "contacts, organizations, deals or activities (Salesforce names work too: Contact, Lead, Account, Opportunity, Task, Event)"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.query",
      "title": "Query (SOQL)",
      "description": "Run a read-only SOQL-style query: SELECT fields FROM object WHERE ... ORDER BY ... LIMIT n. Objects and fields by our names or Salesforce names (Opportunity, CloseDate, Account.Name, Owner.Name, Region__c). Date literals like THIS_QUARTER, LAST_N_DAYS:30; COUNT() and SUM(Amount) with GROUP BY one field. Matches Salesforce soqlQuery.",
      "input": {
        "type": "object",
        "properties": {
          "soql": {
            "type": "string",
            "description": "e.g. SELECT Name, StageName, Amount FROM Opportunity WHERE CloseDate = THIS_QUARTER AND Owner.Name = 'Sam' ORDER BY Amount DESC"
          }
        },
        "required": [
          "soql"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.related",
      "title": "Related records",
      "description": "Records linked to one record: contacts, deals, organizations, activities, open tasks or history. Without a relation, a count of each. Matches Salesforce getRelatedRecords.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The record id"
          },
          "relation": {
            "type": "string",
            "enum": [
              "contacts",
              "deals",
              "organizations",
              "activities",
              "tasks",
              "history"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.recent",
      "title": "Recent records",
      "description": "Records created or changed lately, newest first: mine (\"me\") or the whole team. Matches Salesforce listRecentSobjectRecords.",
      "input": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "description": "\"me\" (default) or \"everyone\", or a name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "organizations",
              "deals",
              "activities"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.whoami",
      "title": "Who am I",
      "description": "The signed-in person, their role, what this connection may do, and what they can see. Matches Salesforce getUserInfo.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.history",
      "title": "Change history",
      "description": "What changed on a record, newest first: field, old and new value, who, and whether it was a person, an agent or an import.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The record id"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.my_tasks",
      "title": "Tasks due",
      "description": "Open tasks, soonest first, with what is overdue. Defaults to the person signed in's; use who \"everyone\" for the team.",
      "input": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "description": "A name, \"me\" (default) or \"everyone\""
          },
          "within_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365,
            "description": "Only tasks due within this many days (overdue always included)"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.pipeline",
      "title": "Pipeline",
      "description": "Deals by stage with counts, totals and weighted totals (amount times probability). Give a stage to list its deals.",
      "input": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "description": "Only this stage"
          },
          "owner": {
            "type": "string",
            "description": "Only this person's deals (name or \"me\")"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.recent_activity",
      "title": "Recent activity",
      "description": "What changed in the CRM lately and who did it: people, and the AI apps they connected (for example \"Claude (Sam's) moved Online booking to Proposal\"), newest first, plus which AI apps are connected right now. Use it to see what other agents did before you act, or when someone asks \"what changed\" or \"what did ChatGPT do\".",
      "input": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "Only changes after this time, e.g. 2026-10-07T14:00"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "At most this many (default 15)"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.find_duplicates",
      "title": "Find duplicates",
      "description": "Groups of contacts, organizations or deals that look like the same one: same email, name, phone or website. Merge them with merge_records.",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "organizations",
              "deals"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.list_deleted",
      "title": "Recently deleted",
      "description": "Records deleted in the last 30 days, newest first. Bring one back with restore_record.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.list_views",
      "title": "Saved views",
      "description": "Saved list views: name, kind, conditions and columns. Open one on the web at /<kind>?view=<id>, or run its conditions with query.",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "organizations",
              "deals",
              "activities"
            ]
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.export_records",
      "title": "Export records",
      "description": "Every record of one kind as CSV, with our headers (imports straight back) or Salesforce API names (for Data Loader). Your data is never stuck here.",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "organizations",
              "deals",
              "activities"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "salesforce"
            ],
            "description": "csv (default) or salesforce"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.import_preview",
      "title": "Preview an import",
      "description": "Check a CSV before importing: how each column is matched, and what happens to every row (new, updated, skipped with the reason). Changes nothing. Salesforce Data Export files and report exports both work.",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "leads",
              "organizations",
              "deals",
              "activities"
            ],
            "description": "What the file holds"
          },
          "csv": {
            "type": "string",
            "description": "The whole CSV file as text"
          },
          "mapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Column name -> field, to override the automatic matching (\"\" leaves a column out)"
          },
          "filename": {
            "type": "string",
            "description": "The file name, e.g. Contact.csv"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "html"
            ],
            "description": "html: the screens use it"
          }
        },
        "required": [
          "kind",
          "csv"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.ask",
      "title": "Ask",
      "description": "The ask box on the home screen: a plain question answered from the records with the tools above (no AI model). Agents should call the tools directly instead.",
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The question"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "read",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.create_contact",
      "title": "Add a contact",
      "description": "Add a person, or a lead (give a status such as \"lead\" and their company). Find them first so there is no duplicate. org links them to an organization by name or id (it must exist; create it with create_organization).",
      "input": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string",
            "description": "Last name"
          },
          "title": {
            "type": "string",
            "description": "Job title"
          },
          "email": {
            "type": "string",
            "description": "Email"
          },
          "phone": {
            "type": "string",
            "description": "Phone"
          },
          "mobile": {
            "type": "string",
            "description": "Mobile"
          },
          "org": {
            "type": "string",
            "description": "Organization name or id"
          },
          "status": {
            "type": "string",
            "description": "A lead status: lead, working, qualified, customer, not_a_fit. Leave out for an ordinary contact."
          },
          "company": {
            "type": "string",
            "description": "Leads: the company as they gave it"
          },
          "source": {
            "type": "string",
            "description": "Where they came from: Web, Phone, Referral, Event, Purchased list, Other"
          },
          "owner": {
            "type": "string",
            "description": "Who looks after them (name). Defaults to you."
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "about": {
            "type": "string",
            "description": "Background worth remembering"
          }
        },
        "required": [
          "first_name"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "write",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.create_organization",
      "title": "Add an organization",
      "description": "Add a company or other organization. Find it first so there is no duplicate.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "description": "Website"
          },
          "industry": {
            "type": "string",
            "description": "Industry"
          },
          "type": {
            "type": "string",
            "description": "Prospect, Customer, Partner, Former customer or Other"
          },
          "phone": {
            "type": "string",
            "description": "Phone"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "parent": {
            "type": "string",
            "description": "Head office: another organization (name or id)"
          },
          "owner": {
            "type": "string",
            "description": "Who looks after it (name). Defaults to you."
          },
          "about": {
            "type": "string",
            "description": "Background worth remembering"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "write",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.create_deal",
      "title": "Add a deal",
      "description": "Add a deal to the pipeline. Link it to an organization and, if known, the contact leading it. Probability follows the stage; the close date defaults to 30 days out.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "What is being sold, e.g. \"Online booking\""
          },
          "org": {
            "type": "string",
            "description": "Organization name or id"
          },
          "contact": {
            "type": "string",
            "description": "Contact name or id"
          },
          "stage": {
            "type": "string",
            "description": "Stage name; defaults to the first stage"
          },
          "amount": {
            "type": "number",
            "description": "Value in the team currency"
          },
          "close_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Expected close date"
          },
          "next_step": {
            "type": "string",
            "description": "The next step"
          },
          "type": {
            "type": "string",
            "description": "New business, Upsell or Renewal"
          },
          "owner": {
            "type": "string",
            "description": "Who owns it (name). Defaults to you."
          },
          "about": {
            "type": "string",
            "description": "Notes"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "write",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.create_record",
      "title": "Create a record",
      "description": "Create any kind of record with any fields, by our field names or Salesforce API names (custom fields too). Kind \"Lead\" makes a contact with status lead. Matches Salesforce createSobjectRecord.",
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "contacts, organizations, deals or activities (Salesforce names work too: Contact, Lead, Account, Opportunity, Task, Event)"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "description": "Field names and values, e.g. {\"LastName\": \"Ortiz\", \"Company\": \"Ortiz Dental\"} or {\"name\": \"Renewal\", \"org\": \"Acme Dental\", \"amount\": 4000}"
          }
        },
        "required": [
          "kind",
          "fields"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "write",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.update_record",
      "title": "Change a record",
      "description": "Change fields on a contact, organization, deal or activity. Send only the fields to change; send an empty string to clear one. Field names can be ours or Salesforce's, and custom fields work by key or Salesforce name. Contact: first_name, last_name, title, email, phone, mobile, org, status, company, source, department, website, street, city, state, postal_code, country, do_not_email, do_not_call, owner, about. Organization: name, website, industry, type, phone, parent, street, city, state, postal_code, country, employees, annual_revenue, source, owner, about. Deal: name, org, contact, stage, amount, probability, close_date, next_step, type, source, lost_reason, owner, about. Activity: type, subject, body, at, end_at, due, done, priority, duration_min, outcome, direction, location, contact, org, deal, owner. Matches Salesforce updateSobjectRecord.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The record id"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "description": "Field names and new values, e.g. {\"title\": \"Partner\", \"phone\": \"555-0100\"}"
          }
        },
        "required": [
          "id",
          "fields"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "scope": "write",
      "confirm": "none",
      "test": "test/unit/mount.test.ts"
    },
    {
      "name": "crm.move_deal",
      "title": "Move a deal",
      "description": "Move a deal to another pipeline stage, e.g. to Proposal, Won or Lost. Probability follows the stage. When a deal is lost, give the reason.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The deal id"
          },
          "stage": {
            "type": "string",
            "description": "Stage name"
          },
