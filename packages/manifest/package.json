{
  "name": "@wos/manifest",
  "version": "1.0.0",
  "description": "The wOS app manifest (wos-app.json): schema, checker, and the types of an app's server part and screen part.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.mjs" },
    "./wos-app.schema.json": "./wos-app.schema.json"
  },
  "bin": { "wos-check-app": "bin/check.mjs" },
  "files": ["index.mjs", "index.d.ts", "wos-app.schema.json", "bin", "README.md", "example"]
}
