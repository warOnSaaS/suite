{
  "name": "wos-suite",
  "version": "0.1.0",
  "private": true,
  "description": "wOS: one app for a team and its AI agents.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning apps/server/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server/main.mjs",
    "dev:shell": "vite --config apps/shell/vite.config.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=60000 test/unit/*.test.ts",
    "test:parity": "node --disable-warning=ExperimentalWarning scripts/parity.mjs",
    "lint:doors": "node scripts/no-side-doors.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "check": "npm run typecheck && npm test && npm run lint:doors && npm run check:clean",
    "sync-kit": "node scripts/sync-kit.mjs",
    "shots": "node scripts/shots.mjs",
    "gen:mounts": "node --disable-warning=ExperimentalWarning scripts/gen-mounts.ts",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:wos@localhost:55499/wos} npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
