# wOS self-host settings. Copy to .env. Only WOS_DOMAIN and WOS_SECRET_KEY are needed to start.

# A domain (or subdomain) whose DNS points at this machine. Caddy gets the HTTPS certificate.
WOS_DOMAIN=wos.example.com
# A long random string. It seals stored API keys; keep a copy somewhere safe. Make one: openssl rand -hex 32
WOS_SECRET_KEY=
# The database password docker compose gives Postgres.
POSTGRES_PASSWORD=change-me
# Or use your own Postgres (Neon, Supabase, RDS, a home server) and drop the postgres service:
# DATABASE_URL=postgres://user:password@host:5432/wos

# Email: sign-in links, invites and alerts. Any mailbox's SMTP works.
# SMTP_URL=smtps://you%40example.com:app-password@smtp.example.com:465
# MAIL_FROM=wOS <wos@example.com>

# GitHub sign-in (optional): create an OAuth app with callback https://<WOS_DOMAIN>/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Let anyone who signs in start their own team (off: only invited people get in).
# WOS_OPEN_SIGNUP=1
# Apps a new team starts with.
# WOS_DEFAULT_APPS=board,crm

# A local model on this server for everyone (optional): Ollama's OpenAI-compatible address.
# OLLAMA_URL=http://host.docker.internal:11434/v1

# Mounted apps keep one workspace per server for now:
# WOS_BOARD_WORKSPACE_DIR=/data/board      a folder, or:
# WOS_BOARD_REPO=owner/repo  WOS_BOARD_GITHUB_TOKEN=...
# WOS_CRM_WORKSPACE_DIR=/data/crm
